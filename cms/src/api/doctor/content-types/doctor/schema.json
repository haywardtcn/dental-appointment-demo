{
  "kind": "collectionType",
  "collectionName": "doctors",
  "info": {
    "singularName": "doctor",
    "pluralName": "doctors",
    "displayName": "醫生 Doctor",
    "description": "計位單位。停用就唔再接新預約；唔可以刪除。"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "nameZh": {
      "type": "string",
      "required": true
    },
    "nameEn": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nameEn",
      "required": true
    },
    "titleZh": {
      "type": "string"
    },
    "titleEn": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "color": {
      "type": "string",
      "default": "#0F5C57",
      "regex": "^#[0-9A-Fa-f]{6}$"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "services": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service.service",
      "mappedBy": "doctors"
    },
    "scheduleRules": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::schedule-rule.schedule-rule",
      "mappedBy": "doctors"
    },
    "reservations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::reservation.reservation",
      "mappedBy": "doctor"
    },
    "waitlistEntries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::waitlist-entry.waitlist-entry",
      "mappedBy": "doctor"
    }
  }
}